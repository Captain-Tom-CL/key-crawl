{
    "manifest_version": 3,
    "name": "Key Crawl",
    "version": "0.1.2",
    "description": "Collect and analyze page content with the Key Crawl desktop service.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "action": {
        "default_title": "Key Crawl",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "options_page": "options/options.html"
}
