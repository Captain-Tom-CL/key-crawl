{
    "manifest_version": 3,
    "name": "Key Crawl",
    "version": "0.1.0",
    "description": "Collect and analyze page content with the Key Crawl desktop service.",
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "permissions": [
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>",
        "http://127.0.0.1:1323/*",
        "http://localhost:1323/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Key Crawl",
        "default_popup": "prompt.html",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_page": "options.html"
}
